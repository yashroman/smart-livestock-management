# ==============================================================================
# SMART LIVESTOCK MANAGEMENT & DECISION SUPPORT SYSTEM - BACKEND ENV TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production (Render / Railway), configure these key-value pairs in the
# Environment Variables dashboard of your hosting service.
# ==============================================================================

# Server Configuration
# (Port is dynamically assigned by Render/Railway; default 5000 locally)
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas Cloud URI)
# Format: mongodb+srv://<username>:<password>@<cluster-address>/smart_livestock_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_livestock_db?retryWrites=true&w=majority

# Security & Authentication
# Generate a strong 32+ character random secret for production
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
# Set to your public Vercel frontend URL (comma-separated if multiple):
CLIENT_ORIGIN=https://your-frontend-app.vercel.app

# AI Farm Assistant Configuration (Google Gemini API)
# Get a free Gemini API key from https://aistudio.google.com/
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Backward-compatibility alias
GEMINI_API_KEY=your_gemini_api_key_here
